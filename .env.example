# Copy to .env for local runs. In Deepnote use Integrations > Environment variables instead.
LITELLM_API_KEY=
SWISSAI_API_KEY=
# Optional tracing (T19, lexgraph/tracing.py): set LANGSMITH_TRACING=true and a key from smith.langchain.com.
# Personal data is masked with the input-guard rules before a run is sent.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=swiss-legal-agent
